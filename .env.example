# ---------------------------------------------------------------------------
# Video-Promotional environment template. Copy to .env and fill in secrets:
#   cp .env.example .env
# The Docker scripts (scripts/docker_*.sh) auto-create .env from this file.
# ---------------------------------------------------------------------------

# ---- AI backend -----------------------------------------------------------
# Which backend drives the digestion + scriptwriting AI calls:
#   agent_sdk  (default) — Claude Agent SDK (spawns the `claude` CLI, talks the
#                          Anthropic protocol to the gateway below)
#   http                 — legacy direct OpenAI-compatible HTTP client
AI_BACKEND=agent_sdk

# Provider registry seed / default (OpenAI-compatible endpoint, key, model).
# Used by both backends. For agent_sdk, the endpoint host is reinterpreted as
# an Anthropic base URL unless ANTHROPIC_BASE_URL is set explicitly below.
AI_ENDPOINT=http://oneapi.yhroot.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=glm-4.6-chat
AI_TIMEOUT=120
AI_MAX_RETRIES=2

# ---- Claude Agent SDK / Anthropic protocol --------------------------------
# Leave blank to derive from AI_ENDPOINT/AI_API_KEY above. Set explicitly to
# point at a gateway whose Anthropic route lives on a sub-path, e.g. DeepSeek:
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
# Path to the `claude` CLI. Blank = SDK auto-locates (bundled, else on PATH).
CLAUDE_CLI_PATH=

# ---- Public footage (Wikimedia Commons) -----------------------------------
# No API key is required. Keep downloads bounded for autonomous agent runs.
FOOTAGE_USER_AGENT="VideoPromotional/1.0 (local AI media scout)"
FOOTAGE_TIMEOUT=45
FOOTAGE_MAX_BYTES=52428800

# ---- TTS (VibeVoice) ------------------------------------------------------
# VibeVoice runs on the host (Apple MPS); see README for the Docker caveat.
AIWORK_ROOT=/Volumes/TP-1TB/AIWork
TTS_DEVICE=mps
TTS_DEFAULT_MODEL=vibevoice-1.5b
TTS_DEFAULT_VOICE_1=Carter
TTS_DEFAULT_VOICE_2=Alice

# ---- HyperFrames render ---------------------------------------------------
HYPERFRAME_DIR=./hyperframe
HYPERFRAMES_VERSION=0.6.99
RENDER_FPS=15
RENDER_QUALITY=draft
RENDER_WORKERS=2

# ---- Paths & server -------------------------------------------------------
# In Docker these are absolute paths mapped to named volumes (see compose).
OUTPUTS_DIR=./outputs
UPLOADS_DIR=./uploads
DB_PATH=
# Host port the app is published on.
APP_PORT=8100
